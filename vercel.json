{
  "installCommand": "pnpm install --filter @typeai/frontend... --ignore-scripts",
  "buildCommand": "pnpm build-fe",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/typing-feedback.cjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
